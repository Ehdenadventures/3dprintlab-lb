# Copy to .env.local for local work. On Vercel, add these under Settings > Environment Variables,
# then redeploy (public values are baked in at build time).

# Supabase (Project Settings > API). Leave empty to run in preview mode with the starting catalog.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin page at /admin. Use a long password.
ADMIN_PASSWORD=
# Optional extra secret for signing the admin login cookie.
ADMIN_SECRET=

# Shop details
NEXT_PUBLIC_SITE_URL=https://3dprintlab-lb.com
# WhatsApp number, international format, digits only (961 + number without the leading 0)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM=3dprintlab.lb
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_DELIVERY_FEE_USD=4

# Wakilni (back office > Settings > Api Tokens > Link to your custom app)
# Start with the test server, switch to https://api.wakilni.com when a test delivery works.
WAKILNI_BASE_URL=https://api-dev.wakilni.com
WAKILNI_KEY=
WAKILNI_SECRET=
# Your pickup location as Wakilni knows it
WAKILNI_PICKUP_LOCATION_ID=
WAKILNI_PICKUP_AREA=
WAKILNI_PICKUP_LAT=
WAKILNI_PICKUP_LNG=
WAKILNI_PICKUP_FLOOR=0
# true = send every new order to Wakilni automatically. false = use the "Send to Wakilni" button.
WAKILNI_AUTO_SEND=false
