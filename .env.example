# Copy to .env.local for local work. On Vercel, add these under Settings > Environment Variables,
# then redeploy (public values are baked in at build time).

# Supabase (Project Settings > API). Leave empty to run in preview mode with the starting catalog.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin page at /admin. Use a long password.
ADMIN_PASSWORD=
# Optional extra secret for signing the admin login cookie.
ADMIN_SECRET=

# Shop details
NEXT_PUBLIC_SITE_URL=https://3dprintlab-lb.com
# WhatsApp number, international format, digits only (961 + number without the leading 0)
# WhatsApp number now lives in src/lib/site.ts
NEXT_PUBLIC_INSTAGRAM=3dprintlab.lb
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_DELIVERY_FEE_USD=4

# Website verification (optional). Paste only the code from the meta tag's content="..." part.
# Google Search Console > Add property > URL prefix > HTML tag
GOOGLE_SITE_VERIFICATION=
# Meta Business Settings > Brand safety > Domains > Add > Meta-tag
FACEBOOK_DOMAIN_VERIFICATION=

# Wakilni (back office > Settings > Api Tokens > Link to your custom app)
# Start with the test server, switch to https://api.wakilni.com when a test delivery works.
WAKILNI_BASE_URL=https://api-dev.wakilni.com
WAKILNI_KEY=
WAKILNI_SECRET=
# Your pickup location as Wakilni knows it. Already built in (3D PrintLab shop, Zgharta main street,
# Slayib, ground floor), so these are only needed to change it. Location ID: from Wakilni, optional.
WAKILNI_PICKUP_LOCATION_ID=
WAKILNI_PICKUP_AREA=Zgharta
WAKILNI_PICKUP_LAT=34.397375
WAKILNI_PICKUP_LNG=35.894752
WAKILNI_PICKUP_FLOOR=0
# true = send every new order to Wakilni automatically. false = use the "Send to Wakilni" button.
WAKILNI_AUTO_SEND=false

# Email on every new order (resend.com, free). Sign up with the address that should get the emails,
# then API Keys > Create API Key. Several addresses: separate them with commas.
RESEND_API_KEY=
ORDER_EMAIL_TO=
# Optional sender, only after verifying your domain in Resend, e.g. 3D PrintLab LB <orders@3dprintlab-lb.com>
ORDER_EMAIL_FROM=
